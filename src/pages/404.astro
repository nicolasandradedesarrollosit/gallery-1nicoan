---
// Not-found page. Served for any unknown URL: it is not indexed and links back to
// the home page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { path } from '../i18n/routes';

const t = ui.notFound;
---

<BaseLayout seo={{ title: t.title, description: t.body, noindex: true }}>
  <section class="wrap py-28">
    <p class="kicker">404</p>
    <h1 class="mt-5 text-display leading-none font-semibold tracking-tighter">{t.title}</h1>
    <p class="mt-6 text-lg text-muted">{t.body}</p>
    <a class="btn mt-8" href={path()}>{t.home}</a>
  </section>
</BaseLayout>
